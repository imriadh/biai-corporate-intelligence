# BIAI Corporate Intelligence — Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env. It is gitignored.

# ---- AI Provider Configuration ----
# Priority order: provider with a key that responds wins.
# Set AI_PRIMARY_PROVIDER to force one: "grok" | "openrouter" | "nvidia"
AI_PRIMARY_PROVIDER=grok

# xAI Grok (https://x.ai/api)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-0609-beta

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# NVIDIA (https://build.nvidia.com/)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ---- Application ----
# Comma-separated list of origins allowed to call /api/* (CORS)
ALLOWED_ORIGINS=*

# If "true", AI endpoints return a clear error instead of a fallback
AI_STRICT_MODE=false
