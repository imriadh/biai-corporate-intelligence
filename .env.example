# BIAI Corporate Intelligence — Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env. It is gitignored.

# ---- AI Provider Configuration ----
# Priority order: the provider with a key that responds wins.
# Set AI_PRIMARY_PROVIDER to force one: "groq" | "openrouter" | "nvidia"
AI_PRIMARY_PROVIDER=groq

# Groq (https://console.groq.com/keys) — fast, OpenAI-compatible, recommended default
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (https://openrouter.ai/keys) — multi-model fallback
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# NVIDIA (https://build.nvidia.com/) — fallback
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ---- Application ----
# Comma-separated origins allowed to call /api/* (CORS)
ALLOWED_ORIGINS=*

# If "true", AI endpoints return a clear error instead of a fallback
AI_STRICT_MODE=false

# ---- GitHub (optional, used only by the deploy/push script) ----
# GITHUB_TOKEN=
